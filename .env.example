# ==============================================================================
# VerbaClear Production Appliance Environment Configuration
# Designed for 100% offline, air-gapped live event deployment
# ==============================================================================

# Network & Gateway
VERBACLEAR_HOST=0.0.0.0
VERBACLEAR_PORT=8000
VERBACLEAR_LAN_IP=               # Leave blank for auto-discovery or specify static venue LAN IP

# ASR & Speech Pipeline
VERBACLEAR_WHISPER_MODEL=tiny.en # Options: tiny.en (sub-second CPU), base.en, distil-large-v3 (GPU)
VERBACLEAR_COMPUTE_TYPE=int8     # Options: int8 (CPU optimized), float16 (CUDA/Apple Silicon)
VERBACLEAR_DEVICE=cpu            # Options: cpu, cuda
VERBACLEAR_BEAM_SIZE=1           # Greedy decoding for minimal latency
VERBACLEAR_TEMPERATURE=0.0

# VAD Parameters
VERBACLEAR_VAD_THRESHOLD=0.5
VERBACLEAR_SILENCE_WINDOW_MS=250 # Trailing silence required to trigger speech chunk emission

# Audio Interface
VERBACLEAR_AUDIO_DEVICE_INDEX=   # Leave blank for system default or specify PortAudio index
VERBACLEAR_SAMPLE_RATE=16000

# Stage Display Parameters
VERBACLEAR_STAGE_DURATION_S=7.0
VERBACLEAR_STAGE_SEPARATION_S=4.0 # Anti-collision queue stagger delay between consecutive cards

# Logging
LOG_LEVEL=INFO
